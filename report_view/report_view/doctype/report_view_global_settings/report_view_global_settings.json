   "fieldname": "limits_tab_section",
   "fieldtype": "Section Break",
   "label": "Limits",
   "description": "The fixed limits of Report View. The hard caps in the code still apply."
  },
  {
   "fieldname": "max_rows",
   "fieldtype": "Int",
   "label": "Maximum rows of a report",
   "default": "50000",
   "non_negative": 1,
